# ---------------------------------------------------------------------------
# уровень compose
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# бэкенд (fastapi)
# ---------------------------------------------------------------------------
POSTGRES__HOST=postgres
POSTGRES__PORT=5432
POSTGRES__USER=otelier
POSTGRES__PASSWORD=changeme
POSTGRES__DATABASE=otelier

SERVER__HOST=0.0.0.0
SERVER__PORT=8000
SERVER__DOCS_ENABLED=false
# публичный адрес фронтенда для ссылки подтверждения email.
SERVER__PUBLIC_URL=http://localhost

AUTH__SESSION_COOKIE_NAME=session_id
AUTH__SESSION_COOKIE_SECURE=false   # локальный стек работает по http
AUTH__SESSION_TTL_SECONDS=28800
AUTH__SECRET_KEY=replace-with-a-long-random-secret

CORS__ALLOW_ORIGINS=http://localhost

# клиент mailer в бэкенде (тот же токен, что у сервиса mailer ниже)
MAILER__URL=http://mailer:8080
MAILER__X_API_TOKEN=replace-with-a-mailer-api-token

# админ-панель: вход по github oauth
# ADMIN__GITHUB_OAUTH_ENABLED=true
# ADMIN__GITHUB_CLIENT_ID=
# ADMIN__GITHUB_CLIENT_SECRET=
# ADMIN__GITHUB_REDIRECT_URI=https://admin.example.com/api/v1/admin/oauth/github/callback
# ADMIN__GITHUB_ALLOWED_LOGINS=user1

# ---------------------------------------------------------------------------
# mailer (fastapi)
# ---------------------------------------------------------------------------
API__HOST=0.0.0.0
API__PORT=8080
API__X_API_TOKEN=replace-with-a-mailer-api-token
API__ENVIRONMENT=production

# прод-транспорт — resend http api. отправитель должен быть на верифицированном в resend домене.
RESEND__API_KEY=re_replace_me
RESEND__SENDER=Otelier <noreply@rkochetov.com>

# smtp — фолбэк, когда RESEND__API_KEY пуст.
SMTP__HOST=smtp.example.com
SMTP__PORT=587
SMTP__USER=no-reply@example.com
SMTP__PASSWORD=changeme
SMTP__USE_TLS=true
